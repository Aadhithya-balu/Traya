# ---- TRAYA backend environment ----
# Copy to `.env` and adjust.
#
# Every field below maps 1:1 to a field on `app.config.settings.Settings`, and
# `tests/test_security_phase11.py::test_every_settings_field_is_documented_in_the_env_example`
# fails the build if one is missing from this file. An undocumented setting is a
# setting nobody will set correctly.

# ---- App ----
APP_NAME=TRAYA
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# ---- Secrets ----
# Rotating SECRET_KEY without setting ENCRYPTION_KEY makes every stored
# biometric embedding permanently unreadable. Set both, together, deliberately.
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
# Optional separate Fernet key for biometric embeddings. Leave empty to derive
# it from SECRET_KEY.
ENCRYPTION_KEY=

# ---- Database ----
# SQLite (zero-config, demo):  sqlite:///./traya.db
# PostgreSQL (production):     postgresql+psycopg://user:password@localhost:5432/traya
DATABASE_URL=sqlite:///./traya.db
# Used only when DATABASE_URL is unreachable AND DATABASE_ALLOW_FALLBACK is true.
# DEMO_MODE=false refuses the fallback outright, so real medical data cannot
# silently land in a local file.
DATABASE_FALLBACK_URL=
DATABASE_ALLOW_FALLBACK=false
DATABASE_PROBE_TIMEOUT_SECONDS=3.0

# ---- Supabase (optional) ----
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend code. It bypasses RLS, which
# is the control the whole authorization model rests on.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ---- CORS ----
# Explicit allowlist. Add your deployed frontend origins; do not use "*".
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# ---- Rate limiting ----
# Identification is the enumeration vector. Per-IP applies to everyone;
# the per-user limits apply only to a caller presenting a bearer token.
RATE_LIMIT_ENABLED=true
PUBLIC_IDENTIFY_LIMIT=10
PUBLIC_IDENTIFY_WINDOW_SECONDS=60
AUTH_LIMIT=30
AUTH_WINDOW_SECONDS=60
IDENTIFY_USER_LIMIT=20
IDENTIFY_USER_WINDOW_SECONDS=60

# ---- Uploads ----
MAX_UPLOAD_BYTES=6291456
ALLOWED_IMAGE_MIMES=["image/jpeg","image/png","image/webp"]
# Pixel-bomb guard. MAX_UPLOAD_BYTES is defeated by a small file declaring
# enormous dimensions, so dimensions are checked before decoding.
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_ASPECT_RATIO=8.0

# ---- Biometric engine ----
# auto       real provider if the model files are present, else simulation
# yunet      require the real provider; fails loudly if the weights are missing
# simulation force the deterministic provider (tests, demo, no weights)
#
# `opencv` is still accepted as a WARNED ALIAS for `yunet`, because it is the
# value an old deployment may still have. It is not a separate engine and must
# not be documented as one: before Phase 5 it silently ran the simulation while
# claiming to be a real detector.
BIOMETRIC_ENGINE=auto
BIOMETRIC_ALGO_VERSION=traya-pseudo-embedding-v2
# 320 describes the SIMULATION ONLY. The real engine is 128-dimensional. Read
# BiometricEngine().dimension at runtime; never size a buffer from this.
EMBEDDING_DIM=320

# ---- Real face models (fetched, not committed) ----
# backend/scripts/fetch_biometric_models.py verifies a pinned SHA-256 per file.
FACE_MODELS_DIR=./.models
FACE_DETECTOR_MODEL=face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL=face_recognition_sface_2021dec.onnx
FACE_DETECTOR_SCORE_THRESHOLD=0.6
FACE_DETECTOR_NMS_THRESHOLD=0.3
FACE_DETECTOR_TOP_K=5000

# ---- Confidence thresholds ----
# Seeded into system_settings, which OVERRIDE these env vars on a seeded
# database. Editing these will do nothing until the seeded row is changed.
# UNCALIBRATED: these are the simulation's numbers. Phase 10 has not measured
# them against a real corpus. Do not widen them to make a demo look better.
HIGH_CONFIDENCE_THRESHOLD=0.82
REVIEW_THRESHOLD=0.62
FALLBACK_FACE_THRESHOLD=0.6
CONTEXT_BOOST=0.05
SECONDARY_FEATURE_BOOST=0.06
# UNCALIBRATED placeholder, copied from REVIEW_THRESHOLD rather than measured.
ENROLLMENT_MIN_SELF_SIMILARITY=0.62

# ---- Emergency sessions ----
EMERGENCY_SESSION_MINUTES=30
SESSION_RETENTION_DAYS=90

# ---- Demo ----
# false refuses the SQLite fallback and is required for real medical data.
DEMO_MODE=true
# Set by tests/conftest.py only. Do not set it in a deployment.
TESTING=false
