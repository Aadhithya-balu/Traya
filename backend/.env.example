# ---- TRAYA backend environment ----
# Copy to `.env` and adjust.

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
# Optional separate key for encrypting biometric embeddings (Fernet format).
# Leave empty to derive from SECRET_KEY.
ENCRYPTION_KEY=

# Database
# SQLite (zero-config, demo):  sqlite:///./traya.db
# PostgreSQL (production):     postgresql+psycopg://user:password@localhost:5432/traya
DATABASE_URL=sqlite:///./traya.db

# CORS - add your frontend origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Biometric engine: auto | simulation | opencv
BIOMETRIC_ENGINE=auto

# Confidence thresholds (admin-configurable in DB)
HIGH_CONFIDENCE_THRESHOLD=0.82
REVIEW_THRESHOLD=0.62
FALLBACK_FACE_THRESHOLD=0.60
CONTEXT_BOOST=0.05
SECONDARY_FEATURE_BOOST=0.06

# Emergency sessions
EMERGENCY_SESSION_MINUTES=30
SESSION_RETENTION_DAYS=90

# Demo
DEMO_MODE=true
